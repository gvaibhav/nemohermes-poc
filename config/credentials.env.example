# Gemini API Configuration for NemoClaw / Hermes Agent
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider settings
NEMOCLAW_LLM_PROVIDER=gemini
NEMOCLAW_MODEL=gemini-2.5-flash

# OpenShell Sandbox Settings
NEMOCLAW_SANDBOX_NAME=mac-hermes-agent
NEMOCLAW_AGENT=hermes
